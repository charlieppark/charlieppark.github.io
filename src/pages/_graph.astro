---
import Base from '../layouts/Base.astro';
---
<Base title="Graph" description="Co-author network and Erdős path of Chanho Park.">
  <div class="main">
    <h1 class="page-title">Graph</h1>
    <p class="lede muted">An interactive co-author network is coming here.</p>
    <figure class="path">
      <ol>
        <li><strong>Chanho Park</strong></li>
        <li>Leonidas Guibas</li>
        <li>Frances Yao</li>
        <li>Paul Erdős</li>
      </ol>
      <figcaption><b>Fig. 2.</b> Erdős path (length 3), via co-authorship.</figcaption>
    </figure>
  </div>
</Base>

<style>
  .page-title { font-size: 2.4rem; margin-top: 2.5rem; }
  .lede { margin: .6rem 0 0; font-size: .95rem; }
  .path { margin: 2.5rem 0 0; padding: 1.25rem; background: var(--fig-bg); border: 1px solid var(--rule); border-radius: 6px; }
  .path ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
  .path li { font-size: 1.05rem; }
  .path li + li::before { content: '→'; color: var(--accent); margin-right: .5rem; font-family: var(--font-mono); }
  figcaption { margin-top: 1rem; font: 400 .72rem var(--font-mono); color: var(--muted); }
  figcaption b { color: var(--ink); font-weight: 500; }
</style>
