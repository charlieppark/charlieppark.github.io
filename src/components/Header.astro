---
import { NAV, SITE } from '../lib/site';
const { overlay = false } = Astro.props as { overlay?: boolean };
const path = Astro.url.pathname;
---
<header class:list={['frame', { overlay }]}>
  <div class="bar">
    <a class="name" href="/">{SITE.name}</a>
    <nav aria-label="Primary">
      {NAV.map((n) => (
        <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle theme">◐</button>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('header .theme')!;
  btn.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = isDark ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  header { position: relative; z-index: 20; }
  header.overlay { position: absolute; left: 0; right: 0; }
  header.overlay .bar { border-bottom-color: transparent; }
  .bar {
    max-width: calc(var(--measure) + var(--margin-col) + var(--gutter));
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: .5rem 1.5rem;
    padding: 1.75rem 0 .9rem;
    border-bottom: 1px solid var(--rule);
  }
  .name { font: 500 1.6rem/1 var(--font-display); letter-spacing: -0.01em; text-decoration: none; }
  nav { display: flex; align-items: baseline; gap: 1.1rem; font: 400 .8rem var(--font-mono); }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .theme {
    all: unset; cursor: pointer; color: var(--muted); font-size: .95rem; line-height: 1;
    padding: .15rem .3rem; border-radius: 4px;
  }
  .theme:hover { color: var(--accent); }
  .theme:focus-visible { outline: 2px solid var(--accent); }
</style>
