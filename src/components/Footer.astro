---
import { SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="frame">
  <div class="inner">
    <span>© {year} {SITE.name}</span>
    <span class="links">
      <a href={`mailto:${SITE.email}`}>email</a>
      <a href={SITE.links.scholar}>scholar</a>
      <a href={SITE.links.github}>github</a>
      <a href={SITE.links.linkedin}>linkedin</a>
      <a href={SITE.links.x}>x</a>
    </span>
  </div>
</footer>

<style>
  .inner {
    max-width: calc(var(--measure) + var(--margin-col) + var(--gutter));
    margin-top: 5rem; padding: 1.25rem 0 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem;
    font: 400 .75rem var(--font-mono); color: var(--muted);
  }
  .links { display: flex; gap: 1rem; }
  a { text-decoration: none; }
  a:hover { color: var(--accent); }
</style>
